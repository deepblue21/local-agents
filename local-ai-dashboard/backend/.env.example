# ─── Master ────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=7878
DB_PATH=data/dashboard.db
DATA_DIR=data

# Cluster — list workers as: NODES=[{"id":"n1","name":"workstation.local",...}, ...]
# If empty, only the local master is used and the UI shows it alone.
NODES_JSON=[
  {"id":"n1","role":"master","name":"workstation.local","host":"127.0.0.1","port":7879,"icon":"Monitor","os":"auto"},
  {"id":"n2","role":"worker","name":"wsl.local","host":"127.0.0.1","port":7880,"icon":"Server","os":"auto"},
  {"id":"n3","role":"worker","name":"studio.local","host":"127.0.0.1","port":7881,"icon":"Apple","os":"auto"}
]

# ─── Chat provider (Anthropic) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_BASE=http://localhost:11434

# ─── Vector store ──────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
KB_COLLECTION=kb
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
CHUNK_SIZE=600
CHUNK_OVERLAP=60

# ─── Energy ────────────────────────────────────────────────────────────────
PRICE_PER_KWH=0.18
CARBON_PER_KWH=0.42
ENERGY_POLL_SECONDS=10

# ─── Worker mode (run on each non-master node) ─────────────────────────────
WORKER_HOST=0.0.0.0
WORKER_PORT=7879
