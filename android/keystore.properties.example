# Gerçek release imzalama için bu dosyayı `keystore.properties` olarak KOPYALAYIN
# ve doldurun. Bu dosya .gitignore'dadır — gerçek parolalar ASLA git'e girmemeli.
# Anahtar üretimi ve tam adımlar: docs/RELEASE.md
#
# storeFile yolu, android/ (rootProject) dizinine göre çözülür.

storeFile=keystores/local-agents-upload.jks
storePassword=BURAYA_STORE_PAROLASI
keyAlias=upload
keyPassword=BURAYA_ANAHTAR_PAROLASI
