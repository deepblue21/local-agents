<?xml version="1.0" encoding="utf-8"?>
<!--
  Güvenlik duruşu: üretimde companion'a erişim Cloudflare Tunnel üzerinden TLS iledir,
  bu yüzden cleartext (şifresiz HTTP) varsayılan olarak kapalıdır. Cleartext yalnızca
  yerel geliştirme hostları ve bu PC'nin Tailscale tailnet alanı için açıktır.

  Gerçek cihazda LAN üzerinden şifresiz test ediyorsan, PC'nin yerel IP'sini buraya
  <domain> olarak ekle (ör. 192.168.1.20). Üretim adresleri https olduğundan etkilenmez.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="true">tail033a5f.ts.net</domain>
        <domain includeSubdomains="false">salih.tail033a5f.ts.net</domain>
    </domain-config>
</network-security-config>
