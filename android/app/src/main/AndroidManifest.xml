<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LocalAgents">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.LocalAgents">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="localagents" android:host="pair" />
            </intent-filter>
        </activity>

        <activity
            android:name=".widget.LocalAgentsWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.LocalAgents">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.LocalAgentsWidgetActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".widget.LocalAgentsMiniWidgetProvider"
            android:exported="false"
            android:label="@string/widget_mini_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agent_1x1" />
        </receiver>

        <receiver
            android:name=".widget.LocalAgentsStatusWidgetProvider"
            android:exported="false"
            android:label="@string/widget_status_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agent_2x1" />
        </receiver>

        <receiver
            android:name=".widget.LocalAgentsSummaryWidgetProvider"
            android:exported="false"
            android:label="@string/widget_summary_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agent_2x2" />
        </receiver>

        <receiver
            android:name=".widget.LocalAgentsControlWidgetProvider"
            android:exported="false"
            android:label="@string/widget_control_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agent_4x2" />
        </receiver>

        <receiver
            android:name=".widget.LocalAgentsStripWidgetProvider"
            android:exported="false"
            android:label="@string/widget_strip_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agent_4x1" />
        </receiver>

        <receiver
            android:name=".widget.LocalAgentsFeedWidgetProvider"
            android:exported="false"
            android:label="@string/widget_feed_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agent_2x3" />
        </receiver>

        <service
            android:name=".widget.LocalAgentsWidgetFeedService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
