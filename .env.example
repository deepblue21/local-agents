LOCAL_AGENTS_HOST=0.0.0.0
LOCAL_AGENTS_PORT=8787
LOCAL_AGENTS_HOST_PORT=8787
LOCAL_AGENTS_DATABASE=/data/local_agents.db
LOCAL_AGENTS_PUBLIC_URL=https://agents.example.com
LOCAL_AGENTS_ADMIN_TOKEN=replace-with-at-least-32-random-characters
# Isolated local development only. Leave disabled before any tunnel/public exposure.
LOCAL_AGENTS_ALLOW_INSECURE_ADMIN=0
LOCAL_AGENTS_AUTH_RATE_LIMIT_PER_MINUTE=12
# Networks whose CF-Connecting-IP / X-Forwarded-For headers may be trusted. Empty means
# trust nobody, which is correct for a directly exposed port. Set this to the tunnel or
# reverse-proxy network so per-client rate limits track real clients again.
LOCAL_AGENTS_TRUSTED_PROXY_NETWORKS=
LOCAL_AGENTS_HEALTH_CACHE_SECONDS=5
LOCAL_AGENTS_RETENTION_SWEEP_HOURS=12
LOCAL_AGENTS_PAIRING_CODE_MINUTES=240
LOCAL_AGENTS_OLLAMA_URL=http://host.docker.internal:11434
LOCAL_AGENTS_DEFAULT_MODEL=qwen3.6
LOCAL_AGENTS_NOVA_URL=http://host.docker.internal:8088/v1
# Populate securely with scripts\connect-nova.ps1; never copy this token to Android.
LOCAL_AGENTS_NOVA_TOKEN=
# Browser console served at /app by the companion. Set to 0 to serve the API and /admin only.
LOCAL_AGENTS_WEB_CONSOLE_ENABLED=1
# Leave unset to derive the cookie Secure flag from the scheme the browser actually used.
# Set to 1 to force it on when the companion is always reached over HTTPS.
#LOCAL_AGENTS_WEB_SESSION_COOKIE_SECURE=1
LOCAL_AGENTS_RUNNER_SOCKET=/run/local-agents/runner.sock
LOCAL_AGENTS_MAX_CONCURRENT_RUNS=1
LOCAL_AGENTS_WORKSPACE=C:/Users/salih/Projects
# Web research runs on the PC companion, never on Android. Options: duckduckgo, brave, disabled.
LOCAL_AGENTS_WEB_SEARCH_PROVIDER=duckduckgo
# Required only when LOCAL_AGENTS_WEB_SEARCH_PROVIDER=brave.
LOCAL_AGENTS_BRAVE_SEARCH_API_KEY=
LOCAL_AGENTS_WEB_SEARCH_TIMEOUT_SECONDS=10
# Keep disabled unless you intentionally want fetch_url to reach private LAN/localhost targets.
LOCAL_AGENTS_WEB_FETCH_ALLOW_PRIVATE=0
CLOUDFLARE_TUNNEL_TOKEN=
